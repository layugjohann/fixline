# Groq free-tier key (https://console.groq.com/keys). Copy to .env.local.
GROQ_API_KEY=
# Optional: override the default Groq model.
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: Gemini free-tier key, used as the fallback model (https://aistudio.google.com/apikey).
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: pin one model instead of Groq-with-Gemini-fallback, as <provider>[:<modelId>]
# with provider groq, gemini, claude or openai. Also the default for `npm run eval`.
# FIXLINE_MODEL=groq:openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# Optional: the LLM judge that grades Draft Reply quality in `npm run eval`, as a model spec.
# Defaults to the model being evaluated.
# FIXLINE_JUDGE_MODEL=groq:openai/gpt-oss-120b

# Live-mode rate limits on the shared free-tier key (run `scripts/setup.sh`; never commit these).
# Upstash Redis (free tier) keeps the counts across serverless instances; without it they are in-memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: daily caps on shared-key live runs, per visitor and overall (defaults 10 and 100).
# FIXLINE_LIVE_RUNS_PER_VISITOR=10
# FIXLINE_LIVE_RUNS_PER_DAY=100

# Optional: your own frontier-model keys (never commit them).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Optional: the real Trello integration (run `scripts/setup.sh trello`; never commit these).
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# The Board `npm run intake` writes to: its id, or the short code from its URL (trello.com/b/<code>/...).
# TRELLO_BOARD_ID=
# A separate, dedicated test Board for `npm run test:trello`. It creates and deletes Work Orders there.
# TRELLO_TEST_BOARD_ID=
