{
  "name": "fixline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "screenshots": "tsx scripts/readme-screenshots.ts",
    "eval": "tsx src/evals/cli.ts",
    "eval:smoke": "tsx src/evals/cli.ts --tag smoke",
    "eval:compare": "tsx src/evals/compare.ts",
    "replay": "tsx src/replays/cli.ts",
    "replay:samples": "tsx src/replays/record-samples.ts",
    "test:trello": "FIXLINE_TRELLO_CONTRACT=1 vitest run src/board/trello.contract.test.ts",
    "intake": "tsx src/intake/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/groq": "^4.0.84",
    "@ai-sdk/openai": "^4.0.118",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.38",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
